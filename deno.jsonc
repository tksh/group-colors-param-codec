{
  "name": "@tksh/group-colors-param-codec",
  "exports": "./src/mod.ts",
  "tasks": {
    "test": "deno test tests/",
    "check": "deno check src/mod.ts",
    "lint": "deno lint",
    "fmt": "deno fmt --check"
  },
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true
  },
  "imports": {
    // Test-only assertions.
    "@std/assert": "jsr:@std/assert@^1.0.1",
    // Self-reference so tests exercise the public entry point.
    "@tksh/group-colors-param-codec": "./src/mod.ts"
  }
}
